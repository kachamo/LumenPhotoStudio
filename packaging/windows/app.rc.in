/* ==========================================================================
 * Lumen Photo Studio - Windows resource script template.
 *
 * Configured by CMake with configure_file(... @ONLY) into
 * ${CMAKE_BINARY_DIR}/packaging/windows/app.rc and compiled into the
 * executable (rc.exe under MSVC, windres under MinGW).
 *
 * Deliberately uses raw numeric constants instead of #include <winver.h> so
 * the script needs no SDK headers and behaves identically under rc.exe and
 * windres:
 *     1          = VS_VERSION_INFO
 *     0x3fL      = VS_FFI_FILEFLAGSMASK
 *     0x40004L   = VOS_NT_WINDOWS32
 *     0x1L       = VFT_APP
 *     0x0L       = VFT2_UNKNOWN
 *
 * The application icon line below is injected by CMake only when
 * packaging/windows/lumen.ico exists; otherwise it expands to a comment.
 * See docs/BUILDING.md - generating that .ico is an outstanding manual step.
 * ========================================================================== */

@LPS_WIN_ICON_RC_LINE@

1 VERSIONINFO
FILEVERSION    @LPS_VER_MAJOR@,@LPS_VER_MINOR@,@LPS_VER_PATCH@,@LPS_VER_TWEAK@
PRODUCTVERSION @LPS_VER_MAJOR@,@LPS_VER_MINOR@,@LPS_VER_PATCH@,@LPS_VER_TWEAK@
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@LPS_COMPANY_NAME@\0"
            VALUE "FileDescription",  "@LPS_APP_DESCRIPTION@\0"
            VALUE "FileVersion",      "@LPS_APP_VERSION@\0"
            VALUE "InternalName",     "@LPS_OUTPUT_NAME@\0"
            VALUE "LegalCopyright",   "@LPS_APP_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@LPS_OUTPUT_NAME@.exe\0"
            VALUE "ProductName",      "@LPS_APP_NAME@\0"
            VALUE "ProductVersion",   "@LPS_APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        /* U.S. English (0x0409), Unicode code page (1200 == 0x04b0). */
        VALUE "Translation", 0x409, 1200
    END
END
